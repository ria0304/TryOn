# backend/.env.example
PORT=8000
DATABASE_URL=sqlite:///./tryon.db
CORS_ORIGINS=http://localhost:3000,http://127.0.0.1:3000
MAX_UPLOAD_BYTES=5242880

# Photorealistic try-on (optional feature, see backend/third_party/CATVTON_SETUP.md).
# "cpu" always works but is slow (minutes/image). Use "cuda" with an NVIDIA
# GPU, or "mps" on Apple Silicon, if available.
TRYON_DEVICE=cpu
